# New-board image selection, not permission to replace an existing layout.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_LIBC_TIME_SYSCALL_USE_RTC_HRT=y
# 28.9375 MiB bootfs needs 512-byte pages for SPIFFS's 16-bit indices.
CONFIG_SPIFFS_PAGE_SIZE=512
